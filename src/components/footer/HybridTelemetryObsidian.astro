<script>
  function updateClientTelemetry() {
    // 1. Viewport / Resolution & DPR
    const w = window.innerWidth;
    const h = window.innerHeight;
    const dpr = window.devicePixelRatio ? Math.round(window.devicePixelRatio * 10) / 10 : 1;
    const resText = `RES: ${w}×${h} @ ${dpr}x DPR`;
    document.querySelectorAll<HTMLElement>('[data-hto-metric="res"]').forEach((el) => {
      el.textContent = resText;
    });

    // 2. Browser Time Zone & UTC Offset
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
      const now = new Date();
      const offsetMinutes = -now.getTimezoneOffset();
      const sign = offsetMinutes >= 0 ? '+' : '-';
      const pad = (n: number) => String(Math.floor(Math.abs(n))).padStart(2, '0');
      const hours = pad(offsetMinutes / 60);
      const mins = pad(offsetMinutes % 60);
      const tzText = `TZ: ${tz} (UTC${sign}${hours}:${mins})`;
      document.querySelectorAll<HTMLElement>('[data-hto-metric="tz"]').forEach((el) => {
        el.textContent = tzText;
      });
    } catch {
      document.querySelectorAll<HTMLElement>('[data-hto-metric="tz"]').forEach((el) => {
        el.textContent = 'TZ: UTC';
      });
    }

    // 3. Client Locale & Hardware Concurrency
    const lang = (navigator.language || 'en').toUpperCase();
    const cores = navigator.hardwareConcurrency ? ` // ${navigator.hardwareConcurrency} CORES` : '';
    const sysText = `LOCALE: ${lang}${cores}`;
    document.querySelectorAll<HTMLElement>('[data-hto-metric="sys"]').forEach((el) => {
      el.textContent = sysText;
    });

    // 4. Connection & Network Info
    const nav = navigator as Navigator & {
      connection?: { effectiveType?: string; rtt?: number };
      mozConnection?: { effectiveType?: string; rtt?: number };
      webkitConnection?: { effectiveType?: string; rtt?: number };
    };
    const conn = nav.connection || nav.mozConnection || nav.webkitConnection;
    let netText = navigator.onLine ? 'NET: ONLINE' : 'NET: OFFLINE';
    if (conn && conn.effectiveType) {
      const type = conn.effectiveType.toUpperCase();
      const rtt = conn.rtt ? ` (~${conn.rtt}ms RTT)` : '';
      netText = `NET: ${type}${rtt}`;
    }
    document.querySelectorAll<HTMLElement>('[data-hto-metric="net"]').forEach((el) => {
      el.textContent = netText;
    });
  }

  // Initial update
  updateClientTelemetry();

  // Dynamic window resize listener
  window.addEventListener('resize', () => {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const dpr = window.devicePixelRatio ? Math.round(window.devicePixelRatio * 10) / 10 : 1;
    const resText = `RES: ${w}×${h} @ ${dpr}x DPR`;
    document.querySelectorAll<HTMLElement>('[data-hto-metric="res"]').forEach((el) => {
      el.textContent = resText;
    });
  });

  // Online / offline listeners
  window.addEventListener('online', updateClientTelemetry);
  window.addEventListener('offline', updateClientTelemetry);
</script>

<style>
  /* =========================================================================
     Variant 06: Hybrid Telemetry Obsidian Scoped Design System
     Fonts strictly retained from Variant 04 (Prompt + JetBrains Mono)
     ========================================================================= */
  .hto {
    --hto-sans: var(--sans-serif-font, 'Prompt', sans-serif);
    --hto-mono: 'JetBrains Mono', var(--monospace-font, monospace);

    --hto-obsidian: #111111;
    --hto-charcoal: #131315;
    --hto-plum: #711452;
    --hto-plum-hover: #8e1f69;
    --hto-cyan: #9fe0ff;
    --hto-white: #ffffff;
    --hto-line: #393e46;
    --hto-border-subtle: #28282e;
    --hto-muted: #5c626f;
    --hto-muted-dark: #71717a;
    --hto-green: #10b981;
    --hto-success: #1a882e;

    /* Middle section white background */
    --hto-mid-bg: #ffffff;
    --hto-mid-ink: #111111;
    --hto-mid-muted: #555a64;
    --hto-mid-line: rgba(57, 62, 70, 0.18);
    --hto-mid-pill: #f4f4f7;

    /* Bottom grounding section black background */
    --hto-bot-bg: #0d0d0f;
    --hto-bot-ink: #f2f2f5;
    --hto-bot-muted: #8c909a;
    --hto-bot-line: #24242a;

    position: relative;
    width: 100%;
    margin-top: 3rem;
    border: 1px solid var(--hto-line);
    border-radius: 2px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    font-family: var(--hto-sans);
  }

  /* Dark Theme Adaptations for Middle Section */
  :global(body[data-theme='dark']) .hto {
    --hto-mid-bg: #161619;
    --hto-mid-ink: #f2f2f5;
    --hto-mid-muted: #9fa4b2;
    --hto-mid-line: rgba(255, 255, 255, 0.12);
    --hto-mid-pill: #202026;
  }

  /* Crosshair Corner Markers */
  .hto-crosshair {
    position: absolute;
    font-family: var(--hto-mono);
    font-size: 11px;
    color: var(--hto-muted-dark);
    line-height: 1;
    pointer-events: none;
    z-index: 10;
  }
  .hto-crosshair-tl { top: 3px; left: 4px; }
  .hto-crosshair-tr { top: 3px; right: 4px; }
  .hto-crosshair-bl { bottom: 3px; left: 4px; }
  .hto-crosshair-br { bottom: 3px; right: 4px; }

  /* =========================================================================
     1. TOP DUAL CONSULTATION DECK (FROM VARIANT 04)
     ========================================================================= */
  .hto-dual-deck {
    display: grid;
    grid-template-columns: 1fr;
    border-bottom: 1px solid var(--hto-line);
  }
  @media (min-width: 56em) {
    .hto-dual-deck {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hto-card {
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }
  @media (min-width: 48em) {
    .hto-card {
      padding: 2.75rem 2.25rem;
    }
  }

  .hto-card-inquiry {
    background-color: var(--hto-charcoal);
    color: #ffffff;
    border-bottom: 1px solid var(--hto-line);
  }
  @media (min-width: 56em) {
    .hto-card-inquiry {
      border-bottom: none;
      border-right: 1px solid var(--hto-line);
    }
  }

  .hto-card-booking {
    background-color: var(--hto-plum);
    color: #ffffff;
    overflow: hidden;
  }

  .hto-watermark {
    position: absolute;
    right: -1rem;
    bottom: -1.75rem;
    pointer-events: none;
    user-select: none;
    font-family: var(--hto-sans);
    font-size: 160px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(0, 0, 0, 0.16);
  }

  .hto-relative {
    position: relative;
    z-index: 2;
  }

  .hto-card-tax {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--hto-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .hto-tax-cyan {
    color: var(--hto-cyan);
    font-weight: 600;
  }

  .hto-tax-white {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
  }

  .hto-tax-badge {
    color: #a9a9b3;
    padding: 0.2rem 0.45rem;
    background-color: rgba(20, 20, 24, 0.8);
    border: 1px solid var(--hto-border-subtle);
    border-radius: 2px;
  }

  .hto-tax-badge-white {
    color: #ffffff;
    padding: 0.2rem 0.45rem;
    background-color: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 2px;
  }

  .hto-card-title {
    font-family: var(--hto-sans);
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff;
