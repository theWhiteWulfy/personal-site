---
/**
 * WebmentionDisplay — renders webmentions for a page from webmention.io.
 * Fetched once at build time; renders nothing when there are no mentions
 * or the API is unreachable (e.g. offline builds).
 */
interface Props {
  pageUrl: string;
}

interface JF2Author {
  name?: string;
  photo?: string;
  url?: string;
}

interface JF2Mention {
  'wm-property'?: string;
  author?: JF2Author;
  url?: string;
  published?: string;
  name?: string;
  content?: {
    text?: string;
  };
}

const { pageUrl } = Astro.props;

let mentions: JF2Mention[] = [];

try {
  const res = await fetch(
    `https://webmention.io/api/mentions.jf2?target=${encodeURIComponent(pageUrl)}&per-page=50`
  );
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data?.children)) {
      mentions = data.children;
    }
  }
} catch {
  // Fetch failed (offline build, API down) — render nothing gracefully.
}

const likes = mentions.filter((m) => m['wm-property'] === 'like-of');
const reposts = mentions.filter((m) => m['wm-property'] === 'repost-of');
const replies = mentions.filter((m) => m['wm-property'] === 'in-reply-to');
const otherMentions = mentions.filter(
  (m) => !['like-of', 'repost-of', 'in-reply-to'].includes(m['wm-property'] ?? '')
);

const hasMentions = mentions.length > 0;
---

{hasMentions && (
  <section class="webmentions" aria-label="Webmentions">
    <div class="wm-header">
      <h2 class="wm-main-title">Reactions &amp; Webmentions</h2>
      <span class="wm-count-badge">{mentions.length}</span>
    </div>

    {likes.length > 0 && (
      <div class="wm-group">
        <h3 class="wm-group-title">
          <span class="wm-icon" aria-hidden="true">❤️</span>
          {likes.length} {likes.length === 1 ? 'Like' : 'Likes'}
        </h3>
        <ul class="wm-facepile" role="list">
          {likes.map((m) => {
            const author = m.author;
            return (
              <li class="h-cite wm-facepile-item">
                {author?.url ? (
                  <a
                    class="h-card u-url wm-avatar-link"
                    href={author.url}
                    rel="noopener noreferrer"
                    title={author.name || 'Like by anonymous'}
                  >
                    {author.photo ? (
                      <img
                        class="u-photo wm-avatar"
                        src={author.photo}
                        alt={author.name ?? ''}
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    ) : (
                      <span class="wm-avatar-fallback" aria-hidden="true">
                        {(author.name || '?').charAt(0)}
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="h-card wm-avatar-link" title={author?.name || undefined}>
                    {author?.photo ? (
                      <img
                        class="u-photo wm-avatar"
                        src={author.photo}
                        alt={author?.name ?? ''}
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    ) : (
                      <span class="wm-avatar-fallback" aria-hidden="true">
                        {(author?.name || '?').charAt(0)}
                      </span>
                    )}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {reposts.length > 0 && (
      <div class="wm-group">
        <h3 class="wm-group-title">
          <span class="wm-icon" aria-hidden="true">🔁</span>
          {reposts.length} {reposts.length === 1 ? 'Repost' : 'Reposts'}
        </h3>
        <ul class="wm-facepile" role="list">
          {reposts.map((m) => {
            const author = m.author;
            return (
              <li class="h-cite wm-facepile-item">
                {author?.url ? (
                  <a
                    class="h-card u-url wm-avatar-link"
                    href={author.url}
                    rel="noopener noreferrer"
                    title={author.name || 'Repost by anonymous'}
                  >
                    {author.photo ? (
                      <img
                        class="u-photo wm-avatar"
                        src={author.photo}
                        alt={author.name ?? ''}
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    ) : (
                      <span class="wm-avatar-fallback" aria-hidden="true">
                        {(author.name || '?').charAt(0)}
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="h-card wm-avatar-link" title={author?.name || undefined}>
                    {author?.photo ? (
                      <img
                        class="u-photo wm-avatar"
                        src={author.photo}
                        alt={author?.name ?? ''}
                        width="36"
                        height="36"
                        loading="lazy"
                      />
                    ) : (
                      <span class="wm-avatar-fallback" aria-hidden="true">
                        {(author?.name || '?').charAt(0)}
                      </span>
                    )}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {replies.length > 0 && (
      <div class="wm-group">
        <h3 class="wm-group-title">
          <span class="wm-icon" aria-hidden="true">💬</span>
          {replies.length} {replies.length === 1 ? 'Reply' : 'Replies'}
        </h3>
        <ul class="wm-comment-list" role="list">
          {replies.map((m) => (
            <li class="h-cite wm-comment">
              <div class="wm-comment-header">
                <span class="p-author h-card wm-author">
                  {m.author?.photo ? (
                    <img
                      class="u-photo wm-avatar"
                      src={m.author.photo}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                    />
                  ) : (
                    <span class="wm-avatar-fallback" aria-hidden="true">
                      {(m.author?.name || '?').charAt(0)}
                    </span>
                  )}
                  {m.author?.url ? (
                    <a class="u-url p-name wm-author-name" href={m.author.url} rel="noopener noreferrer">
                      {m.author.name || m.author.url}
                    </a>
                  ) : (
                    <span class="p-name wm-author-name">{m.author?.name || 'Anonymous'}</span>
                  )}
                </span>
                <div class="wm-comment-meta">
                  {m.published && (
                    <time class="dt-published wm-date" datetime={m.published}>
                      {m.published.slice(0, 10)}
                    </time>
                  )}
                  {m.url && (
                    <a class="u-url wm-source" href={m.url} rel="noopener noreferrer" title="View original webmention source">
                      <span>source ↗</span>
                    </a>
                  )}
                </div>
              </div>
              {m.content?.text && (
                <div class="p-content wm-comment-body">
                  <p class="wm-text">{m.content.text}</p>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}

    {otherMentions.length > 0 && (
      <div class="wm-group">
        <h3 class="wm-group-title">
          <span class="wm-icon" aria-hidden="true">🔗</span>
          {otherMentions.length} {otherMentions.length === 1 ? 'Mention' : 'Mentions'}
        </h3>
        <ul class="wm-comment-list" role="list">
          {otherMentions.map((m) => (
            <li class="h-cite wm-comment">
              <div class="wm-comment-header">
                <span class="p-author h-card wm-author">
                  {m.author?.photo ? (
                    <img
                      class="u-photo wm-avatar"
                      src={m.author.photo}
                      alt=""
                      width="36"
                      height="36"
                      loading="lazy"
                    />
                  ) : (
                    <span class="wm-avatar-fallback" aria-hidden="true">
                      {(m.author?.name || '?').charAt(0)}
                    </span>
                  )}
                  {m.author?.url ? (
                    <a class="u-url p-name wm-author-name" href={m.author.url} rel="noopener noreferrer">
                      {m.author.name || m.author.url}
                    </a>
                  ) : (
                    <span class="p-name wm-author-name">{m.author?.name || 'Anonymous'}</span>
                  )}
                </span>
                <div class="wm-comment-meta">
                  {m.published && (
                    <time class="dt-published wm-date" datetime={m.published}>
                      {m.published.slice(0, 10)}
                    </time>
                  )}
                  {m.url && (
                    <a class="u-url wm-source" href={m.url} rel="noopener noreferrer" title="View original webmention source">
                      <span>source ↗</span>
                    </a>
                  )}
                </div>
              </div>
              {m.content?.text ? (
                <div class="p-content wm-comment-body">
                  <p class="wm-text">{m.content.text}</p>
                </div>
              ) : (
                m.name && (
                  <div class="p-name wm-comment-body">
                    <p class="wm-text">{m.name}</p>
                  </div>
                )
              )}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
)}

<style>
  .webmentions {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    width: 100%;
    box-sizing: border-box;
    font-size: var(--text-base);
    color: var(--text-color);
  }

  .wm-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .wm-main-title {
    font-family: var(--serif-font);
    font-size: var(--text-xl);
    font-weight: 400;
    margin: 0;
    color: var(--text-color);
  }

  .wm-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--monospace-font);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background-color: var(--input-background-color);
    color: var(--muted-text-color);
    border: 1px solid var(--border-color);
  }

  .wm-group {
    margin-top: 1.75rem;
  }

  .wm-group + .wm-group {
    margin-top: 2rem;
  }

  .wm-group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sans-serif-font);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-text-color);
    margin: 0 0 1rem 0;
  }

  .wm-icon {
    font-size: 1em;
  }

  .wm-facepile {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wm-facepile-item {
    display: inline-flex;
  }

  .wm-avatar-link {
    display: inline-flex;
    text-decoration: none;
    border-radius: 50%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .wm-avatar-link:hover {
    transform: translateY(-2px) scale(1.08);
    box-shadow: 0 4px 10px var(--shadow-color);
  }

  .wm-avatar,
  .wm-avatar-fallback {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--background-color);
    box-shadow: 0 0 0 1px var(--border-color);
    box-sizing: border-box;
  }

  .wm-avatar-fallback {
    background: var(--input-background-color);
    color: var(--text-color);
    font-family: var(--monospace-font);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .wm-comment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .wm-comment {
    background-color: var(--background-secondary-color, var(--input-background-color));
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s ease;
  }

  .wm-comment:hover {
    border-color: color-mix(in srgb, var(--primary-color) 40%, #fff);
  }

  .wm-comment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .wm-author {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .wm-author-name {
    font-family: var(--sans-serif-font);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-color);
    text-decoration: none;
  }

  .wm-author-name:hover {
    text-decoration: underline;
  }

  .wm-comment-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--monospace-font);
    font-size: var(--text-xs);
    color: var(--muted-text-color);
  }

  .wm-date {
    color: var(--muted-text-color);
  }

  .wm-source {
    color: var(--muted-text-color);
    text-decoration: none;
    padding: 0.15rem 0.4rem;
    border-radius: var(--border-radius);
    background-color: var(--input-background-color);
    border: 1px solid var(--border-color);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .wm-source:hover {
    color: var(--text-color);
    border-color: var(--text-color);
    text-decoration: none;
  }

  .wm-comment-body {
    font-family: var(--sans-serif-font);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-color);
  }

  .wm-text {
    margin: 0;
    word-break: break-word;
  }
</style>
